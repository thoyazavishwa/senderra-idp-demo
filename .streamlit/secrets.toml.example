# Streamlit secrets — the deployed app's configuration.
#
# WHERE THIS GOES
# ---------------
# Streamlit Community Cloud: paste the filled-in contents into
#   Manage app → Settings → Secrets
# Saving there restarts the app. There is no file to commit and nothing to
# deploy; this template exists so the required keys are written down somewhere
# that is safe to put in git.
#
# Locally you can instead copy this to `.streamlit/secrets.toml` (gitignored),
# but `.env` is the normal local path. Precedence, highest first: a real
# environment variable, then these secrets, then `.env`.
#
# Keys are flat strings, matching the environment variables in `.env.example`
# one-for-one. `config.py` folds them into os.environ, so a setting behaves
# identically whichever of the three sources it came from.
#
# EVERY VALUE IS QUOTED, INCLUDING NUMBERS AND true/false. A bare TOML `20` or
# `true` also works — `config.py` stringifies whatever it is handed — but one
# convention beats two, and quoting is the one that cannot surprise you.

# --- required -----------------------------------------------------------------

# The storage account the pipeline writes to. EITHER form works:
#
#   account key (full control of the account — fine locally, not on a public URL)
#     "DefaultEndpointsProtocol=https;AccountName=<acct>;AccountKey=<key>;EndpointSuffix=core.windows.net"
#
#   SAS token (scoped and expiring — what a deployed demo should use)
#     "BlobEndpoint=https://<acct>.blob.core.windows.net/;SharedAccessSignature=sv=2024-11-04&ss=b&srt=co&sp=rlac&se=..."
#
# See the README for the `az storage account generate-sas` command that produces
# the second form with exactly the permissions this app needs.
STORAGE_CONNECTION_STRING = ""

# Shared password for the demo. REQUIRED when deployed: a Community Cloud app URL
# is reachable by anyone who has it, and this app's upload tab starts billed
# pipeline runs. The app refuses to start without it on a cloud host.
APP_PASSWORD = ""

# --- Cosmos DB: the queryable projection --------------------------------------
#
# WHAT TURNING THIS ON CHANGES, AND WHAT IT DOES NOT
#
#   on  → the dashboard table's stage records come from ONE Cosmos query
#   off → they come from a metrics listing plus N blob downloads (the ETag path)
#
# The per-document detail screen reads BLOBS either way. That is a correctness
# requirement, not a leftover: the projection strips `classify_evidence` because
# it is document prose — PHI — along with `calls`, `pages` and `cost_warnings`,
# and those four are exactly what the detail and raw-JSON tabs exist to show.
#
# Two ways this goes quietly wrong, both worth knowing before the demo:
#
#   * All THREE of ENABLED/ENDPOINT/KEY must be set, or the app falls back to
#     blobs without complaining. That fallback is deliberate — a half-configured
#     Cosmos must not take the dashboard down — but it means an empty KEY looks
#     like "Cosmos did nothing" rather than an error.
#   * If Cosmos is reachable but the query fails, the sidebar says so and keeps
#     serving the last good snapshot. On a cold start there is no snapshot, so the
#     table is empty and the reason is in the sidebar. Set ENABLED to "false" to
#     get the blob path back without touching anything else.
#
# `CosmosStore.last_ru` records the RU charged by the last query — an aggregate
# whose cost grows with the corpus is worth watching rather than discovering on a
# bill. Nothing displays it yet; it is read from the object or the logs.
COSMOS_ENABLED = "true"

# Account endpoint, straight from the portal (Keys → URI). A trailing slash is
# fine — `config.py` strips it.
COSMOS_ENDPOINT = "https://cosmos-senderra-idp.documents.azure.com:443/"

# ⚠️ USE A READ-ONLY KEY. This app only ever runs `SELECT` — it never writes to
# Cosmos — so the primary key grants it nothing it needs and grants an attacker
# everything. The read-only pair is a separate credential on the same account:
#
#   az cosmosdb keys list --name <account> --resource-group <rg> \
#     --type read-only --query primaryReadonlyMasterKey -o tsv
#
# Portal equivalent: Keys → Read-only Keys → PRIMARY READ-ONLY KEY.
COSMOS_KEY = ""

# Database and container holding the projection. These are the pipeline's own
# defaults — change only if you changed them there.
COSMOS_DATABASE = "senderra-idp"
COSMOS_CONTAINER = "documents"

# ⚠️ NETWORKING, for both Cosmos and the storage account. Streamlit Community
# Cloud has no fixed egress IP addresses, so a firewall set to "Selected
# networks" will refuse it and there is no address you can add to fix that. Both
# resources must accept public network access for a Cloud deployment. If your
# security posture does not allow that, deploy the Dockerfile to Container Apps
# inside the VNet instead — the app code is identical.

# --- optional (defaults are correct unless the pipeline was changed) ----------

# CONTAINER_DOCS = "docs-in"
# CONTAINER_WORK = "work"
# CONTAINER_RESULTS = "results"
# CONTAINER_METRICS = "metrics"

# The run id uploads are grouped under. Keep it distinct from benchmark runs.
# UPLOAD_RUN_ID = "ui"

# How long a synced snapshot is served before the next interaction refreshes it.
# Raise it if several people are watching at once: on the blob path each refresh
# is one list call with no downloads while ETags match, and on the Cosmos path it
# is one query whose RU you are paying for.
# SYNC_TTL_SECONDS = "20"

# Parallel blob downloads on the first load. Pure network wait, so well above the
# core count is right — but this is multiplied by the number of viewers, and above
# ~64 concurrent requests the storage account starts returning 503. Unused on the
# Cosmos path, which is a single query.
# MAX_WORKERS = "16"

# Cap on one upload batch, in MB. Streamlit buffers uploads in the server process
# and the SDK copies them again, so a batch costs roughly twice its size in RAM —
# on a host with about 1 GB for everything and everyone.
# UPLOAD_BATCH_MB = "100"

# Force the password gate on a host that is not detected as cloud (the gate is
# already mandatory under /mount/src). Any value other than "true" is ignored.
# REQUIRE_PASSWORD = "true"
