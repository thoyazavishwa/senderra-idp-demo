# Senderra IDP demo UI — settings
#
# Only STORAGE_CONNECTION_STRING is required. Everything else has a working
# default. If this file is absent the app falls back to ../.env, so a checkout
# that already has the pipeline configured needs no extra setup.

# The SAME storage account the pipeline writes to. Read-only for the dashboard;
# write access is needed only for the upload tab (docs-in).
STORAGE_CONNECTION_STRING=

# Containers. These match the pipeline's own defaults — change only if you
# changed them there.
CONTAINER_DOCS=docs-in
CONTAINER_WORK=work
CONTAINER_RESULTS=results
CONTAINER_METRICS=metrics

# Uploads land at docs-in/<UPLOAD_RUN_ID>/<name>.pdf. The pipeline reconstructs
# run_id from that first path segment, so this is the run the demo's own
# documents are grouped under. Keep it distinct from benchmark run ids
# (r000-…, r002-…) so the dashboard can separate demo traffic from benchmarks.
UPLOAD_RUN_ID=ui

# How long a synced snapshot is served before the next interaction re-lists the
# metrics container. Listing is one cheap call; only new blobs are downloaded.
SYNC_TTL_SECONDS=20

# Parallel blob downloads. The work is pure network wait, so threads well above
# the core count are correct. Above ~64 the storage account starts throttling.
MAX_WORKERS=32
